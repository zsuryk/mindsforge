HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./mindsforge.db
# Logging: DEBUG for verbose output, INFO for standard (default), WARNING for quiet
LOG_LEVEL=INFO
# Required — jobs fail without these (scoring is fail-closed)
# Generate a Mind or contact me for the Minds keys
MINDS_BUILDER_API_KEY=
MINDS_AGENT_ID=
# Trend research (chat): get a free key at https://tavily.com
TAVILY_API_KEY=
# Transcription uses local Whisper by default (WHISPER_MODEL defaults to small;
# first use downloads the model once, then runs offline).
# HF_TOKEN (optional) authenticates the local model download from Hugging Face Hub —
# needed to avoid rate limits / the unauthenticated-requests warning.
TRANSCRIPTION_PROVIDER=local
WHISPER_MODEL=small
HF_TOKEN=
FFMPEG_BIN=ffmpeg
PROCESS_JOBS_ON_SUBMIT=true
