HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./mindsforge.db
# Logging: DEBUG for verbose output, INFO for standard (default), WARNING for quiet
LOG_LEVEL=INFO

# LLM backend — any OpenAI-compatible chat completions endpoint. Everything the
# Mind generates (clip scores, experiment verdicts, adaptation features, chat
# replies) is fail-closed: a failed call fails that unit with an error naming
# these settings instead of degrading.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=120
# API key — required for OpenAI and OpenRouter; leave empty for local servers
# that ignore auth (Ollama, LM Studio, vLLM). A key is sent when set.
OPENAI_API_KEY=

# Provider examples — copy the block you need over the four settings above.
#
# OpenAI (the defaults above):
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_MODEL=gpt-4o-mini
#   OPENAI_API_KEY=sk-...
#
# Ollama — fully offline; no key needed (ollama pull llama3.1 first):
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_MODEL=llama3.1
#   OPENAI_API_KEY=
#
# LM Studio — start the local server from the GUI (default port 1234); the
# model id is the one shown in its developer/server log:
#   OPENAI_BASE_URL=http://localhost:1234/v1
#   OPENAI_MODEL=<model id from LM Studio>
#   OPENAI_API_KEY=
#
# OpenRouter — one key, many hosted models:
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=anthropic/claude-sonnet-4.5
#   OPENAI_API_KEY=sk-or-...

# Trend research (chat): get a free key at https://tavily.com
TAVILY_API_KEY=
# Transcription uses local Whisper by default (WHISPER_MODEL defaults to small;
# first use downloads the model once, then runs offline).
# HF_TOKEN (optional) authenticates the local model download from Hugging Face Hub —
# needed to avoid rate limits / the unauthenticated-requests warning.
TRANSCRIPTION_PROVIDER=local
WHISPER_MODEL=small
HF_TOKEN=
FFMPEG_BIN=ffmpeg
PROCESS_JOBS_ON_SUBMIT=true
