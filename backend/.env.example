HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./mindsforge.db
# Required — jobs fail without these (scoring is fail-closed)
# Generate a Mind or contact me for the Minds keys; get a free Groq key at https://console.groq.com
MINDS_BUILDER_API_KEY=
MINDS_AGENT_ID=
# Transcription: GROQ_API_KEY is needed for TRANSCRIPTION_PROVIDER=groq (default).
# Set TRANSCRIPTION_PROVIDER=local to transcribe with local Whisper instead
# (WHISPER_MODEL defaults to small; first use downloads the model once, then runs offline).
# HF_TOKEN (optional) authenticates the local model download from Hugging Face Hub —
# needed to avoid rate limits / the unauthenticated-requests warning.
GROQ_API_KEY=
TRANSCRIPTION_PROVIDER=groq
WHISPER_MODEL=small
HF_TOKEN=
FFMPEG_BIN=ffmpeg
PROCESS_JOBS_ON_SUBMIT=true
